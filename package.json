{
  "name": "gabilyrics",
  "version": "1.0.0",
  "description": "Gabilyrics",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node test/search.test.js && node test/online.test.js",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac"
  },
  "author": "Gabriel Ochai",
  "repository": {
    "type": "git",
    "url": "https://github.com/EmperorGabi/gabilyrics.git"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "productName": "Gabilyrics",
  "build": {
    "appId": "com.gabrielochai.gabilyrics",
    "productName": "Gabilyrics",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/node_modules/grandi/**",
      "**/node_modules/@grandi/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "src/assets/icon.ico",
      "artifactName": "Gabilyrics-Setup-${version}.${ext}"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.video",
      "icon": "src/assets/icon.png",
      "artifactName": "Gabilyrics-${version}-${arch}.${ext}"
    },
    "linux": {
      "target": "AppImage",
      "icon": "src/assets/icon.png"
    },
    "copyright": "Copyright © 2026 Gabriel Ochai",
    "afterPack": "build/adhoc-sign.js",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Gabilyrics"
    }
  },
  "dependencies": {
    "grandi": "2.0.2"
  }
}
