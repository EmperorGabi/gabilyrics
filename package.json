{
  "name": "gabilyrics",
  "version": "1.0.0",
  "description": "Gabilyrics",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node test/search.test.js && node test/online.test.js",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac"
  },
  "author": "Gabriel Ochai",
  "license": "UNLICENSED",
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "productName": "Gabilyrics",
  "build": {
    "appId": "com.gabrielochai.gabilyrics",
    "productName": "Gabilyrics",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/node_modules/grandi/**",
      "**/node_modules/@grandi/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "src/assets/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.video",
      "icon": "src/assets/icon.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "src/assets/icon.png"
    },
    "copyright": "Copyright © 2026 Gabriel Ochai"
  },
  "dependencies": {
    "grandi": "2.0.2"
  }
}
